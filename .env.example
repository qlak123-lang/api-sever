# Cloudflare Workers 로컬 개발(.dev.vars)에 사용되는 환경변수 설정 파일입니다.
# 실제 프로덕션 환경(배포 후)에서는 Cloudflare Dashboard의 Workers > Settings > Variables에서 비밀 환경변수로 등록해 주세요.

# 구글 Gemini API 키
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API 키 (선택사항)
OPENAI_API_KEY=your_openai_api_key_here

# 프론트엔드와 백엔드 통신 시 무단 도용 방지를 위해 대조하는 비밀 보안 키
# 예: toss-mini-app-secret-1234
APP_SECRET_KEY=your_app_secret_key_here
